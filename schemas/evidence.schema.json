{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EC5 source-to-claim ledger",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "activity_primary",
              "standard",
              "government_guidance",
              "vendor_primary",
              "generated",
              "student_record"
            ]
          },
          "access_status": {
            "enum": [
              "read",
              "partial",
              "pending_access"
            ]
          },
          "accessed_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "locator_scheme": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "checksum_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "local_checksum_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "local_path": {
            "type": "string",
            "minLength": 1
          },
          "original_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "type",
          "access_status",
          "accessed_on",
          "locator_scheme",
          "notes"
        ]
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "verified_source_content",
              "generated",
              "pending"
            ]
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text",
          "source_id",
          "locator",
          "status",
          "limitations"
        ]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "source_observation",
              "retrospective_analysis",
              "proposal"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_locators": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "locator"
              ]
            }
          },
          "reasoning": {
            "type": "string",
            "minLength": 1
          },
          "counterargument": {
            "type": "string",
            "minLength": 1
          },
          "limitation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "supported",
              "qualified",
              "proposed",
              "pending"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "evidence_ids",
          "source_locators",
          "reasoning",
          "counterargument",
          "limitation",
          "status"
        ]
      }
    }
  },
  "required": [
    "sources",
    "observations",
    "claims"
  ]
}
